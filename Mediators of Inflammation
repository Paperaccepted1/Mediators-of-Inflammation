#Read long-format data, compute each patient's platelet nadir and its day over days 0-7, and merge the time of AKI onset
read_cohort <- function(file_name, cohort_name) {
  d_long <- readxl::read_excel(file.path(data_dir, file_name))
  need_vars <- c("stay_id", "day", "Subtype_Name", "outcome_aki_7d", platelet_var, aki_onset_var, stats::na.omit(aki_onset_day_var))
  miss_vars <- setdiff(need_vars, colnames(d_long))
  if (length(miss_vars) > 0) {
    cat(cohort_name, "possibly relevant columns:", paste(grep("plt|platelet|aki|onset", colnames(d_long), value = TRUE, ignore.case = TRUE), collapse = ", "), "\n")
    stop(paste0(cohort_name, " missing variables: ", paste(miss_vars, collapse = ", ")))
  }
  #Platelet nadir and its day for each patient (earliest day if tied)
  nadir_df <- d_long %>%
    dplyr::filter(day >= 0, day <= window_end_day, !is.na(.data[[platelet_var]])) %>%
    dplyr::group_by(stay_id) %>%
    dplyr::summarise(n_days = dplyr::n_distinct(day),
                     nadir_value = min(.data[[platelet_var]]),
                     nadir_day = min(day[.data[[platelet_var]] == min(.data[[platelet_var]])]),
                     .groups = "drop")
  keep_vars <- as.character(stats::na.omit(c(aki_onset_day_var, "hos_outcome", "hos_los")))
  base_df <- d_long %>%
    dplyr::filter(day == 0) %>%
    dplyr::select(stay_id, Subtype_Name, outcome_aki_7d, dplyr::all_of(aki_onset_var), dplyr::any_of(keep_vars)) %>%
    dplyr::rename(aki_onset_hour = dplyr::all_of(aki_onset_var)) %>%
    dplyr::left_join(nadir_df, by = "stay_id") %>%
    dplyr::filter(!is.na(outcome_aki_7d), !is.na(Subtype_Name)) %>%
    dplyr::mutate(Cohort = cohort_name,
                  Subtype_Name = factor(Subtype_Name, levels = group_levels),
                  aki_onset_hour = ifelse(outcome_aki_7d == 1, aki_onset_hour, NA_real_),
                  aki_onset_day_cont = aki_onset_hour / 24)
  if (!is.na(aki_onset_day_var)) base_df$aki_onset_day <- ifelse(base_df$outcome_aki_7d == 1, base_df[[aki_onset_day_var]], NA_real_) else base_df$aki_onset_day <- floor(base_df$aki_onset_hour / 24)
  #Data checks
  cat("\n", cohort_name, ":", nrow(base_df), "patients, AKI", sum(base_df$outcome_aki_7d == 1), "\n")
  cat("Patients and AKI by subtype:\n")
  print(table(base_df$Subtype_Name, base_df$outcome_aki_7d))
  cat("Days with a platelet count per patient (should all be", window_end_day + 1, "):\n")
  print(table(base_df$n_days, useNA = "ifany"))
  cat("AKI patients with missing onset time:", sum(base_df$outcome_aki_7d == 1 & is.na(base_df$aki_onset_hour)), "\n")
  cat("Distribution of AKI onset time (hours):\n")
  print(summary(base_df$aki_onset_hour[base_df$outcome_aki_7d == 1]))
  cat("AKI onset before 24 h (should be 0):", sum(base_df$aki_onset_hour < 24, na.rm = TRUE), "\n")
  cat("Distribution of AKI onset day:\n")
  print(table(base_df$aki_onset_day, useNA = "ifany"))
  if (all(c("hos_outcome", "hos_los") %in% colnames(base_df))) cat("In-hospital deaths before day", window_end_day, "(should be 0):", sum(base_df$hos_outcome == 1 & base_df$hos_los / 24 < window_end_day, na.rm = TRUE), "\n")
  base_df
}
