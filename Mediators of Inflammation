#Multivariable models: logistic regression for any AKI, Firth penalized logistic regression for severe AKI; adjusted risk differences by g-computation with bootstrap
fit_adjusted <- function(d, outcome, firth, outcome_label) {
  cn <- unique(d$Cohort)
  dc <- d %>%
    dplyr::select(dplyr::all_of(c(outcome, "Subtype_Model", adjust_vars))) %>%
    stats::na.omit() %>%
    as.data.frame()
  dc$infection_site <- droplevels(dc$infection_site)
  form <- stats::as.formula(paste(outcome, "~ Subtype_Model +", paste(adjust_vars, collapse = " + ")))
  rhs <- stats::delete.response(stats::terms(form))
  mm_names <- colnames(stats::model.matrix(form, dc))
  sub_idx <- grep("^Subtype_Model", mm_names)
  #Fit the main model and extract subtype ORs, 95% CIs and P values
  if (firth) {
    fit <- logistf::logistf(form, data = dc, plconf = sub_idx)
    beta <- fit$coefficients
    or_df <- data.frame(term = names(beta)[sub_idx], OR = exp(beta[sub_idx]),
                        OR_lo = exp(fit$ci.lower[sub_idx]), OR_hi = exp(fit$ci.upper[sub_idx]),
                        P = fit$prob[sub_idx])
  } else {
    fit <- stats::glm(form, data = dc, family = stats::binomial())
    beta <- stats::coef(fit)
    ci <- tryCatch(suppressMessages(stats::confint(fit, parm = names(beta)[sub_idx])),
                   error = function(e) stats::confint.default(fit, parm = names(beta)[sub_idx]))
    or_df <- data.frame(term = names(beta)[sub_idx], OR = exp(beta[sub_idx]),
                        OR_lo = exp(ci[, 1]), OR_hi = exp(ci[, 2]),
                        P = summary(fit)$coefficients[sub_idx, 4])
  }
  or_df$Subtype <- sub("^Subtype_Model", "", or_df$term)
  #g-computation: set all patients to each subtype in turn and average the predicted risks
  risk_by_level <- function(b, dd) {
    sapply(levels(dd$Subtype_Model), function(l) {
      nd <- dd
      nd$Subtype_Model <- factor(l, levels = levels(dd$Subtype_Model))
      X <- stats::model.matrix(rhs, nd)
      bb <- b[colnames(X)]
      bb[is.na(bb)] <- 0
      mean(stats::plogis(drop(X %*% bb)))
    })
  }
  risk_point <- risk_by_level(beta, dc)
  #Bootstrap percentile 95% CI for the adjusted risk difference
  boot_mat <- matrix(NA_real_, nrow = n_boot, ncol = length(risk_point), dimnames = list(NULL, names(risk_point)))
  for (b in seq_len(n_boot)) {
    bd <- dc[sample.int(nrow(dc), replace = TRUE), , drop = FALSE]
    bd$infection_site <- droplevels(bd$infection_site)
    beta_b <- tryCatch(suppressWarnings(if (firth) logistf::logistf(form, data = bd, pl = FALSE)$coefficients else stats::coef(stats::glm(form, data = bd, family = stats::binomial()))), error = function(e) NULL)
    if (!is.null(beta_b)) boot_mat[b, ] <- risk_by_level(beta_b, bd)
    if (b %% 100 == 0) cat(cn, outcome_label, "bootstrap progress:", b, "/", n_boot, "\n")
  }
  n_ok <- sum(stats::complete.cases(boot_mat))
  rd_boot <- 100 * (boot_mat - boot_mat[, ref_level])
  rd_df <- data.frame(Subtype = names(risk_point),
                      Risk = 100 * unname(risk_point),
                      RD = 100 * unname(risk_point - risk_point[ref_level]),
                      RD_lo = unname(apply(rd_boot, 2, stats::quantile, probs = 0.025, na.rm = TRUE)),
                      RD_hi = unname(apply(rd_boot, 2, stats::quantile, probs = 0.975, na.rm = TRUE)))
  #Number of patients and events per subtype in the model
  ev_df <- dc %>%
    dplyr::group_by(Subtype = as.character(Subtype_Model)) %>%
    dplyr::summarise(N_model = dplyr::n(), Events = sum(.data[[outcome]] == 1), .groups = "drop")
  data.frame(Subtype = group_levels) %>%
    dplyr::left_join(ev_df, by = "Subtype") %>%
    dplyr::left_join(or_df %>% dplyr::select(Subtype, OR, OR_lo, OR_hi, P), by = "Subtype") %>%
    dplyr::left_join(rd_df, by = "Subtype") %>%
    dplyr::mutate(Cohort = cn, Outcome = outcome_label,
                  Method = ifelse(firth, "Firth logistic regression", "Logistic regression"),
                  N_total = nrow(dc), Boot_success = n_ok)
}
