#Stratum model: returns patients, events and ORs by subtype (Firth regression in sparse strata)
fit_stratum <- function(dd, covs, sg_label, level_label) {
  dd$infection_site <- droplevels(dd$infection_site)
  covs_use <- covs[sapply(covs, function(v) length(unique(dd[[v]])) > 1)]
  form <- stats::as.formula(paste("y ~ Subtype_Model +", paste(covs_use, collapse = " + ")))
  cell <- table(dd$Subtype_Model, dd$y)
  use_firth <- any(cell < firth_cut)
  if (use_firth) {
    fit <- logistf::logistf(form, data = dd, plconf = 2:4)
    b <- fit$coefficients
    idx <- grep("^Subtype_Model", names(b))
    or_df <- data.frame(Subtype = sub("^Subtype_Model", "", names(b)[idx]), OR = exp(b[idx]),
                        OR_lo = exp(fit$ci.lower[idx]), OR_hi = exp(fit$ci.upper[idx]), P = fit$prob[idx])
  } else {
    fit <- stats::glm(form, data = dd, family = stats::binomial())
    b <- stats::coef(fit)
    idx <- grep("^Subtype_Model", names(b))
    ci <- tryCatch(suppressMessages(stats::confint(fit, parm = names(b)[idx])),
                   error = function(e) stats::confint.default(fit, parm = names(b)[idx]))
    or_df <- data.frame(Subtype = sub("^Subtype_Model", "", names(b)[idx]), OR = exp(b[idx]),
                        OR_lo = exp(ci[, 1]), OR_hi = exp(ci[, 2]), P = summary(fit)$coefficients[idx, 4])
  }
  ev <- dd %>%
    dplyr::group_by(Subtype = as.character(Subtype_Model)) %>%
    dplyr::summarise(N = dplyr::n(), Events = sum(y == 1), .groups = "drop")
  data.frame(Subgroup = sg_label, Level = level_label, Subtype = group_levels) %>%
    dplyr::left_join(ev, by = "Subtype") %>%
    dplyr::left_join(or_df, by = "Subtype") %>%
    dplyr::mutate(N_stratum = nrow(dd), Events_stratum = sum(dd$y == 1),
                  Method = ifelse(use_firth, "Firth", "Logistic"))
}
#Interaction: likelihood ratio test (df = 3) comparing models with and without the subtype-by-subgroup term in the full cohort
interaction_p <- function(dd, sg_var, covs) {
  f0 <- stats::as.formula(paste("y ~ Subtype_Model +", sg_var, "+", paste(covs, collapse = " + ")))
  f1 <- stats::as.formula(paste("y ~ Subtype_Model *", sg_var, "+", paste(covs, collapse = " + ")))
  m0 <- stats::glm(f0, data = dd, family = stats::binomial())
  m1 <- stats::glm(f1, data = dd, family = stats::binomial())
  stats::anova(m0, m1, test = "LRT")$`Pr(>Chi)`[2]
}
