#Summary statistics
median_iqr <- function(x) {
  x <- x[!is.na(x)]
  if (length(x) == 0) return("—")
  sprintf("%.2f [%.2f, %.2f]", median(x), quantile(x, 0.25), quantile(x, 0.75))
}
n_pct <- function(x) {
  x <- x[!is.na(x)]
  n_yes <- sum(as.numeric(x))
  sprintf("%d (%.1f)", n_yes, 100 * n_yes / length(x))
}
np <- function(n, total) sprintf("%d (%.1f)", n, 100*n/total)
calc_pvalue <- function(data, var, group_var, is_binary) {
  tryCatch({
    if (is_binary) {
      tbl <- table(factor(data[[var]]), data[[group_var]])
      if (any(tbl < 5)) p <- fisher.test(tbl, simulate.p.value = TRUE, B = 2000)$p.value
      else p <- chisq.test(tbl)$p.value
    } else {
      p <- kruskal.test(as.formula(paste(var, "~", group_var)), data = data)$p.value
    }
    if (p < 0.001) return("<0.001") else return(sprintf("%.3f", p))
  }, error = function(e) return("—"))
}
#Maximum standardized difference between each subtype and the overall cohort
calc_smd_max <- function(data, var, group_var, is_binary) {
  groups <- levels(data[[group_var]])
  k <- length(groups)
  if (is_binary) {
    props <- sapply(groups, function(g) mean(as.numeric(data[[var]][data[[group_var]] == g]), na.rm = TRUE))
    ns <- sapply(groups, function(g) sum(data[[group_var]] == g))
    p_all <- weighted.mean(props, ns)
    if (p_all == 0 | p_all == 1) return("<0.01")
    return(sprintf("%.2f", max(abs(props - p_all) / sqrt(p_all * (1 - p_all)))))
  } else {
    means <- sapply(groups, function(g) mean(data[[var]][data[[group_var]] == g], na.rm = TRUE))
    sds <- sapply(groups, function(g) sd(data[[var]][data[[group_var]] == g], na.rm = TRUE))
    ns <- sapply(groups, function(g) sum(data[[group_var]] == g))
    overall <- weighted.mean(means, ns)
    pooled <- sqrt(sum((ns - 1) * sds^2) / (sum(ns) - k))
    if (pooled == 0) return("<0.01")
    return(sprintf("%.2f", max(abs(means - overall) / pooled)))
  }
}
#Build one row (fixed group order)
generate_row <- function(data, var, group_var, is_binary) {
  label <- ifelse(var %in% names(var_labels), var_labels[var], var)
  values <- sapply(group_levels, function(g) {
    subset_x <- data[[var]][data[[group_var]] == g]
    if (is_binary) n_pct(subset_x) else median_iqr(subset_x)
  })
  p_val <- calc_pvalue(data, var, group_var, is_binary)
  smd <- calc_smd_max(data, var, group_var, is_binary)
  row <- data.frame(Variable = label, stringsAsFactors = FALSE)
  for (i in seq_along(group_levels)) row[[group_levels[i]]] <- values[i]
  row$P_value <- p_val
  row$SMD <- smd
  return(row)
}
#Section header row
section_row <- function(title) {
  row <- data.frame(Variable = title, stringsAsFactors = FALSE)
  for (g in group_levels) row[[g]] <- ""
  row$P_value <- ""
  row$SMD <- ""
  return(row)
}
#Site of infection cross-tabulated from the data
generate_infection_site_rows <- function(data, group_var) {
  site_labels <- c("Pulmonary", "Abdominal", "Urinary tract",
                   "Bloodstream", "Skin/soft tissue", "Other/unknown")
  sc <- table(data[[group_var]])
  site_table <- table(data$infection_site, data[[group_var]])
  p_val <- tryCatch({
    ct <- chisq.test(site_table)
    if (ct$p.value < 0.001) "<0.001" else sprintf("%.3f", ct$p.value)
  }, error = function(e) "—")
  #SMD: maximum across infection-site dummy variables
  smd_val <- tryCatch({
    max_smd <- 0
    for (site in site_labels) {
      dummy <- as.numeric(data$infection_site == site)
      props <- sapply(group_levels, function(g) mean(dummy[data[[group_var]] == g], na.rm = TRUE))
      ns <- sapply(group_levels, function(g) sum(data[[group_var]] == g))
      p_all <- weighted.mean(props, ns)
      if (p_all > 0 & p_all < 1) {
        site_smd <- max(abs(props - p_all) / sqrt(p_all * (1 - p_all)))
        max_smd <- max(max_smd, site_smd)
      }
    }
    sprintf("%.2f", max_smd)
  }, error = function(e) "—")
  rows <- list()
  for (j in seq_along(site_labels)) {
    row <- data.frame(Variable = paste0("  ", site_labels[j]), stringsAsFactors = FALSE)
    for (g in group_levels) {
      n_site <- ifelse(site_labels[j] %in% rownames(site_table),
                       site_table[site_labels[j], g], 0)
      row[[g]] <- np(n_site, sc[g])
    }
    row$P_value <- ifelse(j == 1, p_val, "")
    row$SMD <- ifelse(j == 1, smd_val, "")
    rows[[j]] <- row
  }
  return(rows)
}
#Build the full table
generate_full_table <- function(data, bin_vars, group_var) {
  rows <- list()
  i <- 1
  rows[[i]] <- section_row("Demographics"); i <- i + 1
  for (v in c("age", "gender", "weight", "bmi")) {
    if (v %in% colnames(data)) { rows[[i]] <- generate_row(data, v, group_var, v %in% bin_vars); i <- i + 1 }
  }
  rows[[i]] <- section_row("Severity scores"); i <- i + 1
  for (v in c("apsiii", "sapsii", "oasis", "lods", "sofa", "modified_sofa", "gcs", "charlson")) {
    if (v %in% colnames(data)) { rows[[i]] <- generate_row(data, v, group_var, FALSE); i <- i + 1 }
  }
  rows[[i]] <- section_row("Vital signs (first 24 h)"); i <- i + 1
  for (v in c("vs_24h_map_first", "vs_24h_sbp_first", "vs_24h_dbp_first",
              "vs_24h_heart_rate_first", "vs_24h_temp_first",
              "vs_24h_resp_rate_first", "vs_24h_spo2_first")) {
    if (v %in% colnames(data)) { rows[[i]] <- generate_row(data, v, group_var, FALSE); i <- i + 1 }
  }
  rows[[i]] <- section_row("Laboratory values (first 24 h)"); i <- i + 1
  for (v in c("baseline_cr", "lab_fst_24h_bun_first", "lab_fst_24h_hco3_first",
              "lab_fst_24h_platelet_first", "lab_fst_24h_wbc_first",
              "lab_fst_24h_hemoglobin_first", "lab_fst_24h_hct_first",
              "lab_fst_24h_inr_first", "lab_fst_24h_pt_first", "lab_fst_24h_aptt_first",
              "lab_fst_24h_ca_first", "lab_fst_24h_cl_first",
              "lab_fst_24h_na_first", "lab_fst_24h_k_first", "lab_fst_24h_bg_first")) {
    if (v %in% colnames(data)) { rows[[i]] <- generate_row(data, v, group_var, FALSE); i <- i + 1 }
  }
  rows[[i]] <- section_row("Treatments (first 24 h)"); i <- i + 1
  for (v in c("itvtn_24h_vent_tag", "drug_24h_vaso_tag", "insulin_use",
              "drug_24h_sedative_tag", "platelet_transfusion", "heparin_use", "nephrotoxic_drugs")) {
    if (v %in% colnames(data)) { rows[[i]] <- generate_row(data, v, group_var, TRUE); i <- i + 1 }
  }
  rows[[i]] <- section_row("Comorbidities"); i <- i + 1
  for (v in c("icd_diabetes", "icd_hypertension", "icd_hf", "icd_liver", "icd_renal",
              "chemo_heme_malig", "asplenia", "iron_deficiency", "any_malignancy", "chronic_inflammatory")) {
    if (v %in% colnames(data)) { rows[[i]] <- generate_row(data, v, group_var, TRUE); i <- i + 1 }
  }
  if ("infection_site" %in% colnames(data)) {
    rows[[i]] <- section_row("Site of infection"); i <- i + 1
    site_rows <- generate_infection_site_rows(data, group_var)
    for (sr in site_rows) { rows[[i]] <- sr; i <- i + 1 }
  }
  result <- bind_rows(rows)
  return(result)
}
