#Continuous NRI and IDI (standard errors by the Pencina method)
calc_idi_nri <- function(p_old, p_new, y) {
  e <- y == 1
  ne <- y == 0
  dif <- p_new - p_old
  idi <- mean(dif[e]) - mean(dif[ne])
  idi_se <- sqrt(stats::var(dif[e]) / sum(e) + stats::var(dif[ne]) / sum(ne))
  up_e <- mean(dif[e] > 0)
  down_e <- mean(dif[e] < 0)
  up_ne <- mean(dif[ne] > 0)
  down_ne <- mean(dif[ne] < 0)
  nri <- (up_e - down_e) + (down_ne - up_ne)
  nri_se <- sqrt((up_e + down_e - (up_e - down_e)^2) / sum(e) + (up_ne + down_ne - (down_ne - up_ne)^2) / sum(ne))
  data.frame(NRI = nri, NRI_lo = nri - 1.96 * nri_se, NRI_hi = nri + 1.96 * nri_se, NRI_P = 2 * stats::pnorm(-abs(nri / nri_se)),
             IDI = idi, IDI_lo = idi - 1.96 * idi_se, IDI_hi = idi + 1.96 * idi_se, IDI_P = 2 * stats::pnorm(-abs(idi / idi_se)))
}
#Fit and compare four nested models
run_cohort <- function(d, cohort_name) {
  cov_str <- paste(adjust_vars, collapse = " + ")
  plt_str <- sprintf("splines::ns(platelet_d0, df = %d)", plt_df)
  forms <- c("Model 1" = paste("y ~", cov_str),
             "Model 2" = paste("y ~", cov_str, "+", plt_str),
             "Model 3" = paste("y ~", cov_str, "+ Subtype_Model"),
             "Model 4" = paste("y ~", cov_str, "+", plt_str, "+ Subtype_Model"))
  model_desc <- c("Model 1" = "Covariates",
                  "Model 2" = "Covariates + day-0 platelet count",
                  "Model 3" = "Covariates + trajectory subtype",
                  "Model 4" = "Covariates + day-0 platelet count + trajectory subtype")
  fits <- lapply(forms, function(f) stats::glm(stats::as.formula(f), data = d, family = stats::binomial()))
  preds <- lapply(fits, stats::fitted)
  rocs <- lapply(preds, function(p) pROC::roc(d$y, p, levels = c(0, 1), direction = "<", quiet = TRUE))
  #Discrimination, AIC and Brier score of each model
  model_tab <- dplyr::bind_rows(lapply(names(fits), function(m) {
    ci <- as.numeric(pROC::ci.auc(rocs[[m]], method = "delong"))
    data.frame(Cohort = cohort_name, Model = m, Description = unname(model_desc[m]), N = nrow(d), Events = sum(d$y == 1),
               AUC = ci[2], AUC_lo = ci[1], AUC_hi = ci[3], AIC = stats::AIC(fits[[m]]), Brier = mean((preds[[m]] - d$y)^2))
  }))
  #Pairwise model comparisons: DeLong test, likelihood ratio test, NRI and IDI
  comp_list <- list(c(1, 2), c(1, 3), c(2, 4), c(3, 4))
  comp_desc <- c("Day-0 platelet count added to covariates",
                 "Trajectory subtype added to covariates",
                 "Trajectory subtype added to day-0 platelet count",
                 "Day-0 platelet count added to trajectory subtype")
  comp_tab <- dplyr::bind_rows(lapply(seq_along(comp_list), function(k) {
    m_old <- names(fits)[comp_list[[k]][1]]
    m_new <- names(fits)[comp_list[[k]][2]]
    rt <- pROC::roc.test(rocs[[m_new]], rocs[[m_old]], method = "delong", paired = TRUE)
    d_ci <- if (!is.null(rt$conf.int)) as.numeric(rt$conf.int) else c(NA_real_, NA_real_)
    lr <- stats::anova(fits[[m_old]], fits[[m_new]], test = "LRT")
    cbind(data.frame(Cohort = cohort_name, Comparison = paste(m_new, "vs", m_old), Description = comp_desc[k],
                     Delta_AUC = as.numeric(pROC::auc(rocs[[m_new]])) - as.numeric(pROC::auc(rocs[[m_old]])),
                     dAUC_lo = d_ci[1], dAUC_hi = d_ci[2], DeLong_P = rt$p.value,
                     LR_chisq = lr$Deviance[2], LR_df = lr$Df[2], LR_P = lr$`Pr(>Chi)`[2]),
          calc_idi_nri(preds[[m_old]], preds[[m_new]], d$y))
  }))
  #Subtype ORs in Models 3 and 4 (Model 4 adjusts for the day-0 platelet count)
  or_tab <- dplyr::bind_rows(lapply(c("Model 3", "Model 4"), function(m) {
    f <- fits[[m]]
    b <- stats::coef(f)
    idx <- grep("^Subtype_Model", names(b))
    ci <- tryCatch(suppressMessages(stats::confint(f, parm = names(b)[idx])),
                   error = function(e) stats::confint.default(f, parm = names(b)[idx]))
    data.frame(Cohort = cohort_name, Model = m, Description = unname(model_desc[m]),
               Subtype = sub("^Subtype_Model", "", names(b)[idx]),
               OR = exp(b[idx]), OR_lo = exp(ci[, 1]), OR_hi = exp(ci[, 2]),
               P = summary(f)$coefficients[idx, 4])
  }))
  list(model = model_tab, comp = comp_tab, or = or_tab)
}
