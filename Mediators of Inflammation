#Single panel: cumulative curves on top (legend top left, P value top right) and number-at-risk table below
plot_panel <- function(cv, o, title_text) {
  y_top <- max(cv$curve$est[cv$curve$time <= o$xmax])
  y_max <- max(10, ceiling(y_top * 1.4 / 10) * 10)
  p_curve <- ggplot(cv$curve, aes(x = time, y = est, colour = Subtype_Name)) +
    geom_step(direction = "hv", linewidth = 0.85) +
    annotate("text", x = o$xmax, y = y_max * 0.97, label = p_expr(cv$p), parse = TRUE, hjust = 1, vjust = 1, size = 3.4) +
    scale_colour_manual(values = subtype_cols, breaks = group_levels, name = NULL, drop = FALSE) +
    scale_x_continuous(breaks = o$breaks) +
    scale_y_continuous(breaks = seq(0, y_max, by = ifelse(y_max > 40, 10, 5))) +
    coord_cartesian(xlim = c(landmark_day, o$xmax), ylim = c(0, y_max), expand = FALSE, clip = "off") +
    labs(x = "Days since ICU admission", y = o$ylab, title = title_text) +
    theme_fig +
    theme(legend.position = "inside", legend.position.inside = c(0.02, 0.98), legend.justification = c(0, 1),
          legend.key.height = unit(0.38, "cm"), legend.text = element_text(size = 9))
  p_risk <- ggplot(cv$risk, aes(x = time, y = Subtype_Name, label = n, colour = Subtype_Name)) +
    geom_text(size = 3) +
    scale_colour_manual(values = subtype_cols, guide = "none") +
    scale_y_discrete(limits = rev(group_levels)) +
    scale_x_continuous(breaks = o$breaks) +
    coord_cartesian(xlim = c(landmark_day, o$xmax), expand = FALSE, clip = "off") +
    labs(x = NULL, y = NULL, title = "Number at risk") +
    theme_classic(base_size = 10) +
    theme(axis.line = element_blank(), axis.ticks = element_blank(), axis.text.x = element_blank(),
          axis.text.y = element_text(colour = "black", size = 9), panel.grid = element_blank(),
          plot.title = element_text(size = 9.5, face = "bold", hjust = 0))
  wrap_elements(full = p_curve / p_risk + plot_layout(heights = c(3.4, 1)))
}
