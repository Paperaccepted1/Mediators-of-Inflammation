#P value format for figures (plotmath expression, italic P)
p_expr <- function(p) {
  if (p < 0.0001) return('paste(italic(P), " < 0.0001")')
  if (p < 0.001) return(paste0('paste(italic(P), " = ', sprintf("%.4f", p), '")'))
  paste0('paste(italic(P), " = ', sprintf("%.3f", p), '")')
}
#P value format for Excel (plain text)
p_text <- function(p) {
  ifelse(is.na(p), "", ifelse(p < 0.0001, "<0.0001", ifelse(p < 0.001, sprintf("%.4f", p), sprintf("%.3f", p))))
}
#Incidence of AKI and severe AKI by subtype (Clopper-Pearson exact 95% CI)
calc_incidence <- function(d) {
  d %>%
    dplyr::group_by(Cohort, Subtype_Name) %>%
    dplyr::summarise(N = dplyr::n(),
                     n_no = sum(AKI_Category == stage_levels[1], na.rm = TRUE),
                     n_s1 = sum(AKI_Category == stage_levels[2], na.rm = TRUE),
                     n_s23 = sum(severe_aki_7d == 1),
                     n_aki = sum(outcome_aki_7d == 1),
                     .groups = "drop") %>%
    dplyr::rowwise() %>%
    dplyr::mutate(aki_rate = 100 * n_aki / N,
                  aki_lo = 100 * stats::binom.test(n_aki, N)$conf.int[1],
                  aki_hi = 100 * stats::binom.test(n_aki, N)$conf.int[2],
                  severe_rate = 100 * n_s23 / N,
                  severe_lo = 100 * stats::binom.test(n_s23, N)$conf.int[1],
                  severe_hi = 100 * stats::binom.test(n_s23, N)$conf.int[2]) %>%
    dplyr::ungroup()
}
#Pairwise comparison of AKI incidence with the Normal subtype (Bonferroni corrected); Fisher exact test when expected counts < 5
calc_pairwise <- function(d) {
  comp_levels <- setdiff(group_levels, ref_level)
  res <- lapply(comp_levels, function(g) {
    sub_d <- d %>% dplyr::filter(Subtype_Name %in% c(ref_level, g))
    tb <- table(droplevels(sub_d$Subtype_Name), sub_d$outcome_aki_7d)
    ct <- suppressWarnings(stats::chisq.test(tb))
    p_raw <- if (any(ct$expected < 5)) stats::fisher.test(tb)$p.value else ct$p.value
    data.frame(Cohort = unique(d$Cohort), Subtype_Name = g, p_raw = p_raw)
  })
  out <- dplyr::bind_rows(res)
  out$p_bonf <- stats::p.adjust(out$p_raw, method = "bonferroni")
  out
}
