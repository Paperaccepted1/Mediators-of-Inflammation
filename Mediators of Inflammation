#P value format for figures (plotmath expression, italic P)
p_expr <- function(p) {
  if (p < 0.0001) return('paste(italic(P), " < 0.0001")')
  if (p < 0.001) return(paste0('paste(italic(P), " = ', sprintf("%.4f", p), '")'))
  paste0('paste(italic(P), " = ', sprintf("%.3f", p), '")')
}
#P value format for Excel (plain text)
p_text <- function(p) {
  ifelse(is.na(p), "", ifelse(p < 0.0001, "<0.0001", ifelse(p < 0.001, sprintf("%.4f", p), sprintf("%.3f", p))))
}
#Median [IQR] format
med_iqr <- function(x) {
  x <- x[!is.na(x)]
  if (length(x) == 0) return("")
  sprintf("%.1f [%.1f, %.1f]", stats::median(x), stats::quantile(x, 0.25), stats::quantile(x, 0.75))
}
#Cumulative incidence of AKI: all patients survived to day 7, so there is no censoring within the window and the cumulative incidence equals cumulative events / total
calc_cuminc <- function(d) {
  fu_end <- ceiling(max(c(window_end_day, d$aki_onset_day_cont[d$outcome_aki_7d == 1]), na.rm = TRUE))
  d <- d %>% dplyr::mutate(time = ifelse(outcome_aki_7d == 1, aki_onset_day_cont, fu_end))
  n_df <- d %>% dplyr::count(Subtype_Name, name = "N")
  ev_df <- d %>% dplyr::filter(outcome_aki_7d == 1, !is.na(time)) %>% dplyr::count(Subtype_Name, time, name = "events")
  curve_df <- ev_df %>%
    dplyr::left_join(n_df, by = "Subtype_Name") %>%
    dplyr::group_by(Subtype_Name) %>%
    dplyr::arrange(time, .by_group = TRUE) %>%
    dplyr::mutate(cuminc = 100 * cumsum(events) / N) %>%
    dplyr::ungroup() %>%
    dplyr::select(Subtype_Name, time, cuminc)
  end_df <- n_df %>%
    dplyr::left_join(curve_df %>% dplyr::group_by(Subtype_Name) %>% dplyr::summarise(cuminc = max(cuminc), .groups = "drop"), by = "Subtype_Name") %>%
    dplyr::mutate(time = fu_end, cuminc = ifelse(is.na(cuminc), 0, cuminc)) %>%
    dplyr::select(Subtype_Name, time, cuminc)
  start_df <- n_df %>% dplyr::mutate(time = 1, cuminc = 0) %>% dplyr::select(Subtype_Name, time, cuminc)
  curve_all <- dplyr::bind_rows(start_df, curve_df, end_df) %>% dplyr::arrange(Subtype_Name, time)
  #Log-rank test comparing the time to AKI across subtypes
  lr <- survival::survdiff(survival::Surv(time, outcome_aki_7d) ~ Subtype_Name, data = d %>% dplyr::filter(!is.na(time)))
  p_lr <- stats::pchisq(lr$chisq, df = length(lr$n) - 1, lower.tail = FALSE)
  #Daily cumulative incidence (for reporting)
  daily <- dplyr::bind_rows(lapply(seq_len(fu_end), function(t) {
    d %>%
      dplyr::group_by(Subtype_Name) %>%
      dplyr::summarise(Day = t, N = dplyr::n(), Events = sum(outcome_aki_7d == 1 & time <= t, na.rm = TRUE), .groups = "drop")
  })) %>%
    dplyr::mutate(Cuminc = 100 * Events / N)
  list(curve = curve_all, p = p_lr, daily = daily, fu_end = fu_end)
}
