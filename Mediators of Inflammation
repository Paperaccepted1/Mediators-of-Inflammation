#Read data, keep day 0 rows (one row per patient), build AKI stage and model variables
read_cohort <- function(file_name, cohort_name) {
  d <- readxl::read_excel(file.path(data_dir, file_name)) %>% dplyr::filter(day == 0)
  need_vars <- c("Subtype_Name", "outcome_aki_7d", "aki_stage_7d", adjust_vars)
  miss_vars <- setdiff(need_vars, colnames(d))
  if (length(miss_vars) > 0) stop(paste0(cohort_name, " missing variables: ", paste(miss_vars, collapse = ", ")))
  n_raw <- nrow(d)
  d <- d %>% dplyr::filter(!is.na(outcome_aki_7d), !is.na(Subtype_Name))
  cat(cohort_name, ": read", n_raw, "patients; complete outcome and subtype", nrow(d), "patients\n")
  d <- d %>%
    dplyr::mutate(
      Cohort = cohort_name,
      Subtype_Name = factor(Subtype_Name, levels = group_levels),
      Subtype_Model = stats::relevel(factor(as.character(Subtype_Name), levels = group_levels), ref = ref_level),
      severe_aki_7d = as.integer(outcome_aki_7d == 1 & !is.na(aki_stage_7d) & aki_stage_7d >= 2),
      AKI_Category = dplyr::case_when(
        outcome_aki_7d == 0 ~ stage_levels[1],
        aki_stage_7d == 1 ~ stage_levels[2],
        aki_stage_7d >= 2 ~ stage_levels[3],
        TRUE ~ NA_character_
      ),
      AKI_Category = factor(AKI_Category, levels = stage_levels),
      infection_site = factor(infection_site)
    )
  if ("Pulmonary" %in% levels(d$infection_site)) d$infection_site <- stats::relevel(d$infection_site, ref = "Pulmonary")
  if (any(is.na(d$AKI_Category))) cat("Note:", sum(is.na(d$AKI_Category)), "AKI patients without stage\n")
  d
}
