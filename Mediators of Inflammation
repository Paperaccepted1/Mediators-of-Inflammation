#Landmark data: keep patients still under follow-up on day 7, with time counted from day 7
prep_outcome <- function(d, o) {
  d %>%
    dplyr::mutate(t_day = .data[[o$time]] / time_unit_hours, status = .data[[o$status]]) %>%
    dplyr::filter(!is.na(t_day), !is.na(status), t_day >= landmark_day) %>%
    dplyr::mutate(time_lm = pmax(t_day - landmark_day, 1 / time_unit_hours))
}
#Value of a step curve at a given time
est_at <- function(curve, g, t) {
  x <- curve$est[curve$Subtype_Name == g & curve$time <= t]
  if (length(x) == 0) 0 else utils::tail(x, 1)
}
#Cumulative incidence curves, group comparison and numbers at risk
calc_curve <- function(dd, o) {
  if (o$key == "hosp") {
    #In-hospital death: Aalen-Johansen cumulative incidence (discharge alive as competing event), Gray test
    dd$event_f <- factor(ifelse(dd$status == 1, "death", "discharge"), levels = c("censor", "death", "discharge"))
    fit <- survival::survfit(survival::Surv(time_lm, event_f) ~ Subtype_Name, data = dd)
    est <- fit$pstate[, match("death", fit$states)]
    gt <- cmprsk::cuminc(ftime = dd$time_lm, fstatus = as.integer(dd$event_f) - 1, group = dd$Subtype_Name, cencode = 0)
    p <- gt$Tests["1", "pv"]
    test_name <- "Gray's test"
  } else {
    #28-day and 1-year mortality: Kaplan-Meier cumulative mortality, log-rank test
    fit <- survival::survfit(survival::Surv(time_lm, status) ~ Subtype_Name, data = dd)
    est <- 1 - fit$surv
    lr <- survival::survdiff(survival::Surv(time_lm, status) ~ Subtype_Name, data = dd)
    p <- stats::pchisq(lr$chisq, df = length(lr$n) - 1, lower.tail = FALSE)
    test_name <- "Log-rank test"
  }
  st <- rep(sub("^Subtype_Name=", "", names(fit$strata)), fit$strata)
  curve <- dplyr::bind_rows(data.frame(Subtype_Name = levels(droplevels(dd$Subtype_Name)), time = landmark_day, est = 0),
                            data.frame(Subtype_Name = st, time = fit$time + landmark_day, est = 100 * est)) %>%
    dplyr::mutate(Subtype_Name = factor(Subtype_Name, levels = group_levels)) %>%
    dplyr::arrange(Subtype_Name, time)
  #Number at risk: patients still under follow-up at time t (no event and not censored)
  risk <- tidyr::expand_grid(Subtype_Name = factor(group_levels, levels = group_levels), time = o$breaks)
  risk$n <- mapply(function(g, t) sum(dd$Subtype_Name == g & dd$time_lm + landmark_day >= t), as.character(risk$Subtype_Name), risk$time)
  risk$est <- mapply(function(g, t) est_at(curve, g, t), as.character(risk$Subtype_Name), risk$time)
  list(curve = curve, risk = risk, p = p, test = test_name)
}
#Crude and adjusted HRs: Fine-Gray subdistribution hazard model for in-hospital death; landmark Cox models for 28-day and 1-year mortality
fit_models <- function(dd, o) {
  cov_str <- paste(adjust_vars, collapse = " + ")
  mdat <- dd %>%
    dplyr::select(time_lm, status, Subtype_Model, dplyr::all_of(adjust_vars)) %>%
    stats::na.omit() %>%
    as.data.frame()
  mdat$infection_site <- droplevels(mdat$infection_site)
  extract_hr <- function(fit) {
    s <- summary(fit)
    idx <- grep("^Subtype_Model", rownames(s$coefficients))
    data.frame(Subtype = sub("^Subtype_Model", "", rownames(s$coefficients)[idx]),
               HR = s$conf.int[idx, "exp(coef)"], HR_lo = s$conf.int[idx, "lower .95"], HR_hi = s$conf.int[idx, "upper .95"],
               P = s$coefficients[idx, ncol(s$coefficients)])
  }
  if (o$key == "hosp") {
    mdat$event_f <- factor(ifelse(mdat$status == 1, "death", "discharge"), levels = c("censor", "death", "discharge"))
    fg_c <- survival::finegray(survival::Surv(time_lm, event_f) ~ Subtype_Model, data = mdat, etype = "death")
    fit_c <- survival::coxph(survival::Surv(fgstart, fgstop, fgstatus) ~ Subtype_Model, weights = fgwt, data = fg_c)
    fg_a <- survival::finegray(stats::as.formula(paste("survival::Surv(time_lm, event_f) ~ Subtype_Model +", cov_str)), data = mdat, etype = "death")
    fit_a <- survival::coxph(stats::as.formula(paste("survival::Surv(fgstart, fgstop, fgstatus) ~ Subtype_Model +", cov_str)), weights = fgwt, data = fg_a)
    method <- "Fine-Gray subdistribution hazard model"
    ph_sub <- NA_real_
    ph_glob <- NA_real_
  } else {
    fit_c <- survival::coxph(survival::Surv(time_lm, status) ~ Subtype_Model, data = mdat)
    fit_a <- survival::coxph(stats::as.formula(paste("survival::Surv(time_lm, status) ~ Subtype_Model +", cov_str)), data = mdat)
    method <- "Landmark Cox proportional hazards model"
    zph <- tryCatch(survival::cox.zph(fit_a)$table, error = function(e) NULL)
    ph_sub <- if (!is.null(zph)) zph["Subtype_Model", "p"] else NA_real_
    ph_glob <- if (!is.null(zph)) zph["GLOBAL", "p"] else NA_real_
  }
  hr_c <- extract_hr(fit_c) %>% dplyr::rename(cHR = HR, cHR_lo = HR_lo, cHR_hi = HR_hi, cP = P)
  hr_a <- extract_hr(fit_a) %>% dplyr::rename(aHR = HR, aHR_lo = HR_lo, aHR_hi = HR_hi, aP = P)
  ev <- mdat %>%
    dplyr::group_by(Subtype = as.character(Subtype_Model)) %>%
    dplyr::summarise(N = dplyr::n(), Events = sum(status == 1), .groups = "drop")
  data.frame(Subtype = group_levels) %>%
    dplyr::left_join(ev, by = "Subtype") %>%
    dplyr::left_join(hr_c, by = "Subtype") %>%
    dplyr::left_join(hr_a, by = "Subtype") %>%
    dplyr::mutate(Method = method, PH_subtype_P = ph_sub, PH_global_P = ph_glob, N_model = nrow(mdat))
}
